# secrets and local configuration - never commit
.env
*.env
!.env.example
master_key*.txt
*.key
*.pem
secrets/

# runtime data - never commit photos, databases, archives or state
/library/
/state/
/data/
*.sqlite3
*.sqlite3-*
*.sqlite
*.db
*.tcarc
vault.enc*
*.instance-lock

# media files (test data is generated by the tests, never stored)
*.jpg
*.jpeg
*.heic
*.png
!app/frontend/static/img/*.png
*.mov
*.mp4
*.dng

# Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.idea/
.vscode/
.DS_Store
