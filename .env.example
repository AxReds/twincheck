# TwinCheck - copy to .env (cp .env.example .env), then: chmod 600 .env
# Every value here is a placeholder. Never commit the real .env file.

# --- Master key (REQUIRED) -------------------------------------------------------
# Generate it with:  docker compose run --rm app generate-key
# and paste the printed line here, replacing the placeholder below.
# The container refuses to start with this placeholder. Keep the key in a password manager:
# if it is lost, the encrypted vault (accounts and configuration) cannot be recovered.
APP_MASTER_KEY=CHANGE_ME
# Alternative: Docker secret. Set APP_MASTER_KEY=file and the path of the secret:
# APP_MASTER_KEY_FILE=/run/secrets/twincheck_master_key

# --- Network -----------------------------------------------------------------------
# Host address the port 7777 is published on. 127.0.0.1 = reachable only from this host.
BIND_ADDRESS=0.0.0.0
# Allowed client networks (CIDR, comma-separated). Empty = everyone who can reach the port.
ALLOWED_NETWORKS=
# Reverse proxies whose X-Forwarded-For is trusted for login rate limiting only.
TRUSTED_PROXIES=

# --- Host, language, disks -----------------------------------------------------------
HOST_LABEL=my-nas
APP_LANG=en
# Initial library timezone; the admin-only vault setting overrides it.
TZ=
DISK_WARN_FREE_PERCENT=15
DISK_CRIT_FREE_PERCENT=5

# --- Container user and volumes ------------------------------------------------------
# UID/GID that own the library and state folders on the host (id -u / id -g).
PUID=1000
PGID=1000
# Host folders (relative paths are relative to the docker/ folder).
DATA_PATH=../library
STATE_PATH=../state
TMP_SIZE=512m
CONTAINER_NAME=twincheck

# --- Limits and tuning ---------------------------------------------------------------
JOB_WORKERS=2
MAX_REQUEST_KB=1024
MAX_UPLOAD_MB=102400
PREVIEW_CACHE_MAX_MB=2048
LOG_LEVEL=INFO

# --- MariaDB password as Docker secret (optional) --------------------------------------
# MARIADB_PASSWORD_FILE=/run/secrets/twincheck_mariadb_password

# --- Build arguments -------------------------------------------------------------------
ALPINE_VERSION=3.24
APP_VERSION=1.0.0
